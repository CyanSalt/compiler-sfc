{
  "name": "@legacy-vue/compiler-sfc",
  "version": "2.7.16-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "compiler-sfc for Vue 2",
  "main": "dist/compiler-sfc.js",
  "types": "dist/compiler-sfc.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --fix './**/*.{mjs,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{mjs,ts}'",
    "test": "vitest",
    "release": "release-it --preRelease=rc --npm.tag=latest"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "postcss": "^8.5.14",
    "source-map": "^0.6.1"
  },
  "optionalDependencies": {
    "prettier": "^1.18.2 || ^2.0.0"
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "less": "^4.6.4",
    "pug": "^3.0.4",
    "release-it": "^20.0.1",
    "sass": "^1.99.0",
    "stylus": "^0.64.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue": "^2.7.16"
  }
}
